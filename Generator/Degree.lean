import Generator.Cubic
import TerraciniLemma.DegreeCertificate

/-!
# Certificates in any degree

A job asks for `k` points of `𝕜^{n+1}` whose tangent spaces to `v_e` span at least `target`
dimensions: it draws pseudo-random points with coordinates in `{-2, …, 2}`, builds the matrix
`DegreeCertificate.degMatrix` at all monomials of degree `e`, asks Macaulay2 for a rank
certificate, and retries with the next seed until the target is reached. The points and the
certificate, checked by the kernel in chunks (`Cert.toLean`), are written to
`TerraciniLemma/AHCertificates/<name>.lean`.
-/

open Lean DegreeCertificate

namespace Generator

/-- A certificate job: `k` points of `𝕜^{n+1}`, degree `e`, rank at least `target`. -/
structure DegJob where
  name : String
  n : ℕ
  e : ℕ
  k : ℕ
  target : ℕ

/-- Pseudo-random points for a job, from a seed. -/
def DegJob.points (job : DegJob) (seed : ℕ) : List (List ℤ) := Id.run do
  let mut x := seed
  let mut pts : List (List ℤ) := []
  for _ in List.range job.k do
    let mut p : List ℤ := []
    for _ in List.range (job.n + 1) do
      x := lcg x
      p := p ++ [(((x / 65536) % 5 : ℕ) : ℤ) - 2]
    pts := pts ++ [p]
  return pts

/-- Lean source for a list of integer points. -/
def showPoints (pts : List (List ℤ)) : String :=
  "[" ++ ",\n  ".intercalate (pts.map fun p =>
    "[" ++ ", ".intercalate (p.map fun z => if z < 0 then s!"({z})" else toString z) ++ "]") ++ "]"

/-- Run a job and write the Lean file. -/
def DegJob.run (m2 : Macaulay2) (job : DegJob) : IO Unit := do
  let N := job.n + 1
  let rows := allMonos N job.e
  let mut seed := 1
  repeat
    let pts := job.points seed
    let A := (List.range rows.length).map fun r =>
      (List.range (pts.length * N)).map (degMatrix N rows pts r)
    let c ← rankCertificate m2 ⟨A⟩
    if c.rows.length ≥ job.target then
      let src := s!"module

public import TerraciniLemma.DegreeCertificate

/-! Generated by `lake exe certificates` (job `{job.name}`, seed {seed}); do not edit. -/

@[expose] public section

namespace AHCertificates

set_option maxRecDepth 100000

/-- The points of the job `{job.name}`. -/
def {job.name}Data : List (List ℤ) :=
  {showPoints pts}

{c.toLean job.name s!"DegreeCertificate.degMatrix {N} (DegreeCertificate.allMonos {N} {job.e}) {job.name}Data"
  s!"(DegreeCertificate.allMonos {N} {job.e}).length" s!"{job.name}Data.length * {N}"}
end AHCertificates
"
      IO.FS.createDirAll "TerraciniLemma/AHCertificates"
      IO.FS.writeFile s!"TerraciniLemma/AHCertificates/{job.name}.lean" src
      IO.println s!"{job.name}: rank {c.rows.length} (target {job.target}), seed {seed}"
      return
    IO.println s!"{job.name}: seed {seed} gives rank {c.rows.length} < {job.target}, retrying"
    seed := seed + 1

/-- The certificates of the Alexander–Hirschowitz induction: `AH_{5,4}(21)`, which the induction
cannot reach (every route needs the exceptional case `AH_{4,4}(14)`). -/
def degJobs : List DegJob := [⟨"ahN5D4", 5, 4, 21, 126⟩]

end Generator
