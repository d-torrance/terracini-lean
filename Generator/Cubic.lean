import Generator.RankCertificate
import TerraciniLemma.CubicBaseCases

/-!
# Certificates for the cubic base cases

Each job lists points by location (with pseudo-random small integer coordinates, zero on the
blocks of their location), builds the tangent matrix `baseMatrix` of
`TerraciniLemma.CubicBaseCases`, asks Macaulay2 for a rank certificate, and retries with the
next seed until the certified rank reaches the target. The points, the certificate, and a
kernel check of the certificate (`<name>Check`, in chunks by `decide +kernel`; see
`Cert.toLean`) are written to `TerraciniLemma/CubicCertificates/<name>.lean`. Each file
imports the previous one, so that Lake checks them one at a time.
-/

open Lean

namespace Generator

/-- A base case: `N` coordinates, the monomials outside `P̂₀ + ⋯ + P̂_{i-1}` as rows, a number
of points at each location, and the rank the certificate must reach. -/
structure CubicJob where
  name : String
  N : ℕ
  i : ℕ
  locs : List (List ℕ × ℕ)
  target : ℕ

/-- A linear congruential generator. -/
def lcg (x : ℕ) : ℕ := (1103515245 * x + 12345) % 2147483648

/-- Pseudo-random points for a job, from a seed. Coordinates are in `{-2, …, 2}`, zero on the
blocks of the location. -/
def CubicJob.points (job : CubicJob) (seed : ℕ) : LocatedPoints := Id.run do
  let mut x := seed
  let mut data : LocatedPoints := []
  for (loc, count) in job.locs do
    let mut pts : List (List ℤ) := []
    for _ in List.range count do
      let mut p : List ℤ := []
      for a in List.range job.N do
        x := lcg x
        let v : ℤ := ((x / 65536) % 5 : ℕ) - 2
        p := p ++ [if loc.any (fun β => inBlockN β a) then 0 else v]
      pts := pts ++ [p]
    data := data ++ [(loc, pts)]
  return data

/-- Lean source for located points. -/
def showData (data : LocatedPoints) : String :=
  let showList {α} [ToString α] (l : List α) := "[" ++ ", ".intercalate (l.map toString) ++ "]"
  "[" ++ ",\n  ".intercalate (data.map fun (loc, pts) =>
    s!"({showList loc}, {showList (pts.map fun p => showList (p.map fun z =>
      if z < 0 then s!"({z})" else toString z))})") ++ "]"

/-- Run a job: find points whose certificate reaches the target, and write the Lean file. -/
def CubicJob.run (m2 : Macaulay2) (job : CubicJob) (imp : String) : IO Unit := do
  let mut seed := 1
  repeat
    let data := job.points seed
    let m := (baseRows job.N job.i).length
    let n := (allPoints data).length * job.N
    let A := (List.range m).map fun r => (List.range n).map (baseMatrix job.N job.i data r)
    let c ← rankCertificate m2 ⟨A⟩
    if c.rows.length ≥ job.target then
      let src := s!"module

public import {imp}

/-! Generated by `lake exe certificates` (job `{job.name}`, seed {seed}); do not edit.

This file imports the previous certificate file only so that Lake checks the certificates one
at a time: checking one takes several gigabytes of memory. -/

@[expose] public section

namespace CubicCertificates

set_option maxRecDepth 100000

/-- The points of the base case `{job.name}`. -/
def {job.name}Data : LocatedPoints :=
  {showData data}

{c.toLean job.name s!"baseMatrix {job.N} {job.i} {job.name}Data"
  s!"(baseRows {job.N} {job.i}).length" s!"(allPoints {job.name}Data).length * {job.N}"}
end CubicCertificates
"
      IO.FS.createDirAll "TerraciniLemma/CubicCertificates"
      IO.FS.writeFile s!"TerraciniLemma/CubicCertificates/{job.name}.lean" src
      IO.println s!"{job.name}: rank {c.rows.length} (target {job.target}), seed {seed}"
      return
    IO.println s!"{job.name}: seed {seed} gives rank {c.rows.length} < {job.target}, retrying"
    seed := seed + 1

/-- The base cases of the cubic induction (see `TerraciniLemma.CubicInductionMain`). Levels
`t` have `N = t + 5` coordinates; `s₂(t) = ⌈(t+7)(t+6)/6⌉` and `s₁(t) = ⌊(t+7)(t+6)/6⌋`. -/
def cubicJobs : List CubicJob := [
  -- `A_{0,0}(t)`, `t = 1, 2, 3`: `s₂(t)` general points fill the ambient space
  ⟨"cubicB0t1", 6, 0, [([], 10)], 56⟩,
  ⟨"cubicB0t2", 7, 0, [([], 12)], 84⟩,
  ⟨"cubicB0t3", 8, 0, [([], 15)], 120⟩,
  -- `A_{1,1}(t)`, `t = 4, 5, 6`: `t + 5` points, and `s₂(t-3)` points on `U₀`
  ⟨"cubicB1t4", 9, 1, [([], 9), ([0], 10)], 109⟩,
  ⟨"cubicB1t5", 10, 1, [([], 10), ([0], 12)], 136⟩,
  ⟨"cubicB1t6", 11, 1, [([], 11), ([0], 15)], 166⟩,
  -- `A_{2,2}(t)`, `t = 7, 8, 9`: `3` points, and `t + 2` points on each of `U₀`, `U₁`
  ⟨"cubicB2t7", 12, 2, [([], 3), ([0], 9), ([1], 9)], 90⟩,
  ⟨"cubicB2t8", 13, 2, [([], 3), ([0], 10), ([1], 10)], 99⟩,
  ⟨"cubicB2t9", 14, 2, [([], 3), ([0], 11), ([1], 11)], 108⟩,
  -- the uniform case `A_{3,3}`: three points on each of `U₀`, `U₁`, `U₂` in `𝕜⁹`
  ⟨"cubicB3", 9, 3, [([0], 3), ([1], 3), ([2], 3)], 27⟩,
  -- the subabundant chain (`t ≡ 1 mod 3`, `s₁` points)
  ⟨"cubicB0t1Sub", 6, 0, [([], 9)], 54⟩,
  ⟨"cubicB1t4Sub", 9, 1, [([], 9), ([0], 9)], 108⟩,
  -- `n ≤ 4` directly (`N = n + 1` coordinates)
  ⟨"cubicN4Fill", 5, 0, [([], 8)], 35⟩,
  ⟨"cubicN4Indep", 5, 0, [([], 6)], 30⟩,
  ⟨"cubicN3", 4, 0, [([], 5)], 20⟩,
  ⟨"cubicN2Fill", 3, 0, [([], 4)], 10⟩,
  ⟨"cubicN2Indep", 3, 0, [([], 3)], 9⟩,
  ⟨"cubicN1", 2, 0, [([], 2)], 4⟩,
  ⟨"cubicN0", 1, 0, [([], 1)], 1⟩]

end Generator
